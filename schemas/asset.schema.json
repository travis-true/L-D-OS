{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/teos/schemas/asset.schema.json",
  "title": "Asset build specification and candidate record",
  "type": "object",
  "required": ["asset_id", "project_id", "asset_type", "purpose", "audience", "source_ids", "format", "profile", "acceptance_criteria", "restrictions", "owner", "version", "status"],
  "properties": {
    "$schema": {"type": "string"},
    "asset_id": {"type": "string", "pattern": "^AST-[A-Z0-9-]{3,40}$"},
    "project_id": {"type": "string"},
    "asset_type": {"type": "string"},
    "purpose": {"type": "string"},
    "audience": {"type": "string"},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "format": {"type": "string"},
    "profile": {"type": "string"},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "restrictions": {"type": "array", "items": {"type": "string"}},
    "owner": {"type": "string"},
    "version": {"type": "string"},
    "candidate": {"type": "object", "properties": {"candidate_id": {"type": "string"}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "frozen_date": {"type": "string"}}},
    "review_trigger": {"type": "string"},
    "status": {"type": "string", "enum": ["specified", "building", "draft", "candidate", "qa", "authorized", "published", "superseded", "retired"]}
  }
}
