{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/teos/schemas/format-routing.schema.json",
  "type": "object",
  "required": ["catalog_id", "version", "dimensions", "options", "decision_rule"],
  "properties": {
    "$schema": {"type": "string"},
    "catalog_id": {"type": "string"},
    "version": {"type": "string"},
    "dimensions": {"type": "array", "minItems": 5, "items": {"type": "object", "required": ["id", "question", "values"]}},
    "options": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["format", "best_fit", "caution"]}},
    "decision_rule": {"type": "string"}
  }
}
