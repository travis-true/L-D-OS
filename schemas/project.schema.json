{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/teos/schemas/project.schema.json",
  "title": "TEOS project record",
  "type": "object",
  "required": ["project_id", "request_id", "title", "lane", "risk", "classification", "current_state", "owner", "roles", "applicable_gates", "evidence", "created_date", "version"],
  "properties": {
    "$schema": {"type": "string"},
    "project_id": {"type": "string", "pattern": "^PRJ-[A-Z0-9-]{3,40}$"},
    "request_id": {"type": "string", "pattern": "^REQ-[A-Z0-9-]{3,40}$"},
    "title": {"type": "string"},
    "lane": {"type": "string", "enum": ["fast-track", "standard", "controlled"]},
    "risk": {"type": "string", "enum": ["low", "moderate", "high", "critical", "not-verified"]},
    "classification": {"type": "string"},
    "current_state": {"type": "string", "enum": ["submitted", "triage", "governed", "diagnosed", "designed", "building", "review", "authorized", "published", "measuring", "maintenance", "paused", "retired"]},
    "owner": {"type": "string"},
    "roles": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/person_role"}},
    "applicable_gates": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^G[0-9]{2}$"}},
    "conditional_controls": {"type": "array", "items": {"type": "string"}},
    "excluded_controls": {"type": "array", "items": {"type": "object", "required": ["control", "rationale", "authority_status"]}},
    "evidence": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/evidence_ref"}},
    "created_date": {"type": "string", "format": "date"},
    "review_date": {"type": "string"},
    "version": {"type": "string"}
  }
}
