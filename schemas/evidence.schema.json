{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/teos/schemas/evidence.schema.json",
  "title": "Evidence record",
  "type": "object",
  "required": ["evidence_id", "project_id", "title", "type", "description", "location", "version", "status", "classification", "custodian", "captured_date", "control_links"],
  "properties": {
    "$schema": {"type": "string"},
    "evidence_id": {"type": "string", "pattern": "^EVD-[A-Z0-9-]{3,40}$"},
    "project_id": {"type": "string"},
    "title": {"type": "string"},
    "type": {"type": "string", "enum": ["source", "decision", "test", "review", "publication", "measurement", "authorization", "other"]},
    "description": {"type": "string"},
    "location": {"type": "string"},
    "version": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"type": "string", "enum": ["available", "verified", "not-verified", "restricted", "missing", "superseded"]},
    "classification": {"type": "string"},
    "custodian": {"type": "string"},
    "captured_date": {"type": "string", "format": "date"},
    "control_links": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
