{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/teos/schemas/design.schema.json",
  "title": "Intervention design",
  "type": "object",
  "required": ["design_id", "project_id", "outcomes", "audience", "format_routing", "intervention", "scope", "practice", "assessment", "accessibility", "evaluation", "dependencies", "status"],
  "properties": {
    "$schema": {"type": "string"},
    "design_id": {"type": "string", "pattern": "^DSN-[A-Z0-9-]{3,40}$"},
    "project_id": {"type": "string"},
    "outcomes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["audience", "behavior", "condition", "degree"]}},
    "audience": {"type": "string"},
    "format_routing": {"type": "object", "required": ["moment", "memory", "frequency", "criticality", "skill_type", "shelf_life", "reach", "rationale"]},
    "intervention": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "scope": {"type": "object", "required": ["included", "excluded"]},
    "practice": {"type": "array", "items": {"type": "string"}},
    "assessment": {"type": "array", "items": {"type": "string"}},
    "accessibility": {"type": "array", "items": {"type": "string"}},
    "evaluation": {"type": "object", "required": ["target_level", "measures", "limitations"]},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["draft", "reviewed", "approved", "approved-with-conditions", "returned", "not-approved"]}
  }
}
