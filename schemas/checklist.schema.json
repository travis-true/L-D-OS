{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/teos/schemas/checklist.schema.json",
  "title": "Definition-of-done checklist",
  "type": "object",
  "required": ["checklist_id", "asset_type", "version", "categories"],
  "properties": {
    "$schema": {"type": "string"},
    "checklist_id": {"type": "string", "pattern": "^CHK-[A-Z0-9-]{3,40}$"},
    "asset_type": {"type": "string"},
    "version": {"type": "string"},
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "items"],
        "properties": {
          "name": {"type": "string"},
          "items": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["check_id", "requirement", "blocking_if_failed"]}}
        }
      }
    }
  }
}
