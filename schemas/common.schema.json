{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/teos/schemas/common.schema.json",
  "$defs": {
    "record_id": {"type": "string", "pattern": "^[A-Z]{2,8}-[A-Z0-9-]{3,40}$"},
    "iso_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "risk": {"type": "string", "enum": ["low", "moderate", "high", "critical", "not-verified"]},
    "evidence_label": {"type": "string", "enum": ["FACT", "ASSUMPTION", "INFERENCE", "EXAMPLE", "CONFLICT", "GAP", "DECISION REQUIRED", "NOT VERIFIED"]},
    "person_role": {
      "type": "object",
      "required": ["role", "actor", "authority_status"],
      "properties": {
        "role": {"type": "string"},
        "actor": {"type": "string"},
        "authority_status": {"type": "string", "enum": ["assigned", "verified", "not-verified", "not-applicable"]}
      }
    },
    "evidence_ref": {
      "type": "object",
      "required": ["evidence_id", "description", "location", "status"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^EVD-[A-Z0-9-]{3,40}$"},
        "description": {"type": "string"},
        "location": {"type": "string"},
        "status": {"type": "string", "enum": ["available", "verified", "not-verified", "restricted", "missing"]}
      }
    }
  }
}
