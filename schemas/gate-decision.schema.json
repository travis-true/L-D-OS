{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/teos/schemas/gate-decision.schema.json",
  "title": "Gate decision record",
  "type": "object",
  "required": ["decision_id", "project_id", "gate_id", "candidate_or_baseline", "result", "evidence_ids", "conditions", "authority", "authority_status", "decision_date", "next_state"],
  "properties": {
    "$schema": {"type": "string"},
    "decision_id": {"type": "string", "pattern": "^DEC-[A-Z0-9-]{3,40}$"},
    "project_id": {"type": "string"},
    "gate_id": {"type": "string", "pattern": "^G[0-9]{2}$"},
    "candidate_or_baseline": {"type": "string"},
    "result": {"type": "string"},
    "rationale": {"type": "string"},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "authority": {"type": "string"},
    "authority_status": {"type": "string", "enum": ["verified", "not-verified", "not-required"]},
    "decision_date": {"type": "string", "format": "date"},
    "next_state": {"type": "string"}
  }
}
